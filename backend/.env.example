# 智能植物养护系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# 应用配置
APP_NAME=智能植物养护系统
APP_VERSION=1.0.0
DEBUG=False

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS 配置（允许的前端地址）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 数据库配置（必须设置）
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/plant?charset=utf8mb4

# Redis 配置（可选，用于缓存和任务队列）
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# JWT 配置（必须设置随机密钥）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=7200
REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码加密配置
BCRYPT_ROUNDS=12

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# AI 模型配置
AI_MODELS_DIR=../ai_models/models
PLANT_DETECT_MODEL=yolov8n.pt
PLANT_CLASSIFY_MODEL=models/plant_classification/best.pt
DISEASE_MODEL=models/disease_detection/best.pt

# Neo4j 知识图谱配置（可选）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
